# Optional local narration proxy. Defaults to a no-key mock.
NARRATION_PORT=8787
NARRATION_PROVIDER=mock
NARRATION_MODEL=gpt-4.1-mini
NARRATION_MAX_OUTPUT_TOKENS=900
NARRATION_MAX_PROVIDER_REQUESTS=10

# Only set this in the server process environment when intentionally testing a real provider.
# Never put a real key in this file, the browser environment, Git, or chat.
# OPENAI_API_KEY=


# ChatGPT subscription: npm run narration:chatgpt (no API key needed)
# Optional when Vite uses another port:
# NARRATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

