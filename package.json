{
  "name": "shenzhou-three-kingdoms-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "narration": "node server/index.mjs",
    "narration:chatgpt": "node server/index.mjs --chatgpt",
    "build": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "benchmark:history": "node scripts/benchmark-history.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "jose": "^6.2.13",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
